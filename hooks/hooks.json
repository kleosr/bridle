{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|StrReplace",
        "command": "./hooks/lean_gate.sh",
        "timeoutSec": 5,
        "failClosed": true
      },
      {
        "matcher": "Write|Edit|MultiEdit|StrReplace|Bash",
        "command": "./hooks/pre_tool_use.sh",
        "timeoutSec": 5,
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/before_submit_prompt.sh",
        "failClosed": true
      }
    ],
    "sessionStart": [
      {
        "command": "./hooks/session_start.sh",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "./hooks/stop_gate.sh",
        "loop_limit": 5,
        "failClosed": false
      }
    ]
  }
}
