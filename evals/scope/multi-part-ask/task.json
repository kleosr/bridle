    { "file": "README.md", "text": "--debug" },
    { "file": "README.md", "text": "--quiet" }
  ],
  "absent": [
    { "file": "src/cli.js", "text": "--verbose" },
    { "file": "README.md", "text": "--verbose" }
  ]
}
