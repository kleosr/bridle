      ],
      "change": [
        { "path": "payment_processor.py", "content": "class PaymentProcessor:\n    def charge(self):\n        return 1\n" }
      ]
    },
    {
      "id": "conflict-markers",
      "label": "incomplete",
      "base": [
        { "path": "src/config.ts", "content": "export const port = 3000\n" }
      ],
      "change": [
        { "path": "src/config.ts", "content": "<<<<<<< HEAD\nexport const port = 3000\n=======\nexport const port = 8080\n>>>>>>> feature\n" }
      ]
    },
    {
      "id": "not-implemented-stub",
