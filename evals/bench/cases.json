{
  "version": 1,
  "note": "Labelled corpus for the completion-confidence scorer (scripts/complete.sh). Each case materialises a scratch git repo: base[] is committed, change[] is left as the working diff. label incomplete expects verdict escalate; label complete expects verdict act. Negatives include the cases that naive orphan detection gets wrong (entrypoints, framework routes, wired modules, tests, non-source files).",
  "target": { "accuracy": 0.9, "maxFalsePositiveRate": 0.2 },
  "cases": [
    {
      "id": "orphan-service-ts",
      "label": "incomplete",
      "base": [
        { "path": "src/app.ts", "content": "import { a } from './a'\nexport const app = a\n" },
        { "path": "src/a.ts", "content": "export const a = 1\n" }
      ],
      "change": [
        { "path": "src/PaymentService.ts", "content": "export class PaymentService {\n  charge() { return 1 }\n}\n" }
      ]
    },
    {
      "id": "orphan-module-py",
      "label": "incomplete",
      "base": [
