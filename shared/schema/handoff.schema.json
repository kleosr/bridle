{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kleosrules.local/schema/handoff.schema.json",
  "title": "kleosrules session handoff",
  "type": "object",
  "required": ["version", "task", "verified", "remaining", "nextAction"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "task": { "type": "string", "minLength": 1 },
    "investigated": { "type": "array", "items": { "type": "string" } },
    "changed": { "type": "array", "items": { "type": "string" } },
    "verified": {
      "type": "object",
      "required": ["command", "exit"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string" },
        "exit": { "type": "integer" },
        "notes": { "type": "string" }
      }
    },
    "failed": { "type": "array", "items": { "type": "string" } },
    "remaining": { "type": "array", "items": { "type": "string" } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "nextAction": { "type": "string", "minLength": 1 },
    "activeFeature": { "type": ["string", "null"] }
  }
}
