{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kleosrules.local/schema/feature.schema.json",
  "title": "kleosrules feature list",
  "type": "object",
  "required": ["version", "features"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "activeLimit": { "type": "integer", "minimum": 1 },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "priority", "area", "title", "behavior", "verification", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 1 },
          "area": { "type": "string", "minLength": 1 },
          "layer": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "behavior": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["not_started", "in_progress", "blocked", "passing"]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string" },
              "exit": { "type": "integer" },
              "proves": { "type": "string" },
              "recordedAt": { "type": "string" }
            }
          },
          "blockedReason": { "type": "string" },
          "lastFailure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exit", "recordedAt", "nextExperiment"],
            "properties": {
              "command": { "type": "string" },
              "exit": { "type": "integer" },
              "recordedAt": { "type": "string" },
              "nextExperiment": { "type": "string", "minLength": 1 }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
