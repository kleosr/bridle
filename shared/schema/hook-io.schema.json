{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kleosrules.local/schema/hook-io.schema.json",
  "title": "kleosrules hook JSON contracts",
  "description": "Cursor event I/O. Host owns native tools. This pack does not register preToolUse.",
  "oneOf": [
    {
      "title": "beforeSubmitPrompt",
      "type": "object",
      "properties": {
        "continue": { "type": "boolean" },
        "reason": { "type": "string" },
        "user_message": { "type": "string" }
      },
      "required": ["continue"]
    },
    {
      "title": "beforeShellOrRead",
      "type": "object",
      "properties": {
        "permission": { "enum": ["allow", "deny", "ask"] },
        "reason": { "type": "string" },
        "user_message": { "type": "string" },
        "agent_message": { "type": "string" }
      },
      "required": ["permission"]
    },
    {
      "title": "stop",
      "type": "object",
      "properties": {
        "followup_message": { "type": "string" }
      }
    }
  ]
}
