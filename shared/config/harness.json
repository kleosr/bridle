{
  "owner": "kleosrules",
  "version": 7,
  "runtime": {
    "loop": "host",
    "shell": "bash",
    "json": "python3|node"
  },
  "commands": {
    "init": "bash scripts/ready.sh",
    "inventory": "DOCTOR_SKIP_LIVE=1 bash scripts/doctor.sh",
    "verify": "bash tests/run.sh",
    "install": "FORCE=1 bash scripts/install.sh",
    "complete": "bash scripts/complete.sh check",
    "bench": "bash scripts/bench.sh"
  },
  "verification": {
    "default": "scoped"
  },
  "invariants": {
    "hookEventCount": 4,
    "eventHookMaxLines": 80,
    "alwaysOnMaxLines": 80,
    "hooksFrozen": true,
    "noSessionStart": true,
    "noPreToolUse": true,
    "noPackLoop": true
  },
  "layers": [
    "instructions",
    "context",
    "permissions",
    "state",
    "verification",
    "scope",
    "lifecycle",
    "continuity",
    "integration"
  ],
  "requiredEvalDimensions": [
    "completion",
    "verification",
    "regression",
    "unnecessary_edits",
    "context_efficiency",
    "recovery",
    "false_completion",
    "instruction_conflict",
    "execution_reliability",
    "continuity",
    "integration"
  ],
  "extend": {
    "rules": "shared/config/rules.global.txt",
    "skills": "shared/config/skills.txt"
  }
}
