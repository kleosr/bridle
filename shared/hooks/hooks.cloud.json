{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|StrReplace",
        "command": ".cursor/hooks/lean_gate.sh",
        "timeout": 30,
        "failClosed": true
      },
      {
        "matcher": "Write|Edit|MultiEdit|StrReplace|Shell|Bash",
        "command": ".cursor/hooks/pre_tool_use.sh",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/before_shell.sh",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/before_read_file.sh",
        "failClosed": true
      }
    ],
    "beforeTabFileRead": [
      {
        "command": ".cursor/hooks/before_read_file.sh",
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": ".cursor/hooks/before_mcp.sh",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/before_submit_prompt.sh",
        "failClosed": true
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/pre_compact.sh",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/stop_gate.sh",
        "loop_limit": 5,
        "failClosed": false
      }
    ]
  }
}
