{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/before_shell.sh",
        "timeout": 30,
        "failClosed": false
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/before_read_file.sh",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/before_submit_prompt.sh",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
